{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BehaviorSpec",
  "type": "object",
  "required": ["title", "inputs", "state", "rules", "outputs", "notes", "literalStrings", "assumptions"],
  "definitions": {
    "assumption": {
      "type": "object",
      "required": ["description", "choiceMade"],
      "properties": {
        "description": { "type": "string" },
        "choiceMade": { "type": "string" },
        "citation": { "type": "string" }
      }
    }
  },
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind", "description"],
        "properties": {
          "name": { "type": "string" },
          "kind": { "type": "string", "enum": ["key", "mouseClick", "mouseMove", "uiControl"] },
          "description": { "type": "string" }
        }
      }
    },
    "state": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "description"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description"],
        "properties": {
          "description": { "type": "string" },
          "citation": { "type": "string" }
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } },
    "literalStrings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "value"],
        "properties": {
          "name": { "type": "string" },
          "value": { "type": "string" },
          "citation": { "type": "string" }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": { "$ref": "#/definitions/assumption" }
    }
  }
}

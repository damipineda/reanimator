{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Scenario",
  "type": "object",
  "required": ["id", "viewport", "events", "checkpoints"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "seed": { "type": "number" },
    "viewport": {
      "type": "object",
      "required": ["width", "height"],
      "properties": { "width": { "type": "number" }, "height": { "type": "number" } }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["t", "type"],
        "properties": {
          "t": { "type": "number", "minimum": 0 },
          "type": { "type": "string", "enum": ["keydown", "keyup", "mousedown", "mouseup", "mousemove"] },
          "key": { "type": "string" },
          "x": { "type": "number" },
          "y": { "type": "number" }
        }
      }
    },
    "checkpoints": { "type": "array", "items": { "type": "number", "minimum": 0 } }
  }
}
